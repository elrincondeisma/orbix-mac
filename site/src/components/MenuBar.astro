---
// The page header is a Mac menu bar. On the right sit the input-source menu (here, the
// language), the Orbix status item, which follows the session ring as you scroll and opens
// the real panel, and the clock in the visitor's own time.
import Shot from "./Shot.astro";
import compactDark from "../assets/shots/panel-compacta-oscuro.png";
import compactLight from "../assets/shots/panel-compacta-claro.png";
import { locales, localeInfo, homePath, t, type Locale } from "../i18n/config";
import { guidesBase, guideWords, hasGuides } from "../i18n/guides";
import type { Release } from "../lib/release";

interface Props {
  locale: Locale;
  release: Release;
  /** The same page in other languages; languages without it go to their home. */
  alternates?: Partial<Record<Locale, string>>;
  /** On the landing the sections are on this page; elsewhere they link back to it. */
  onLanding?: boolean;
}
const { locale, release, alternates = {}, onLanding = true } = Astro.props;
const sectionHref = (id: string) => `${onLanding ? "" : homePath(locale)}#${id}`;
const dict = t(locale);
const radius = 6.2;
const start = 26;
// The first four stay visible on medium screens, so the guides go fourth.
const sections: { href: string; label: string }[] = [
  { href: sectionHref("session"), label: dict.nav.session },
  { href: sectionHref("panel"), label: dict.nav.panel },
  { href: sectionHref("accounts"), label: dict.nav.accounts },
  ...(hasGuides(locale) ? [{ href: guidesBase[locale], label: guideWords[locale].nav }] : []),
  { href: sectionHref("privacy"), label: dict.nav.privacy },
  { href: sectionHref("install"), label: dict.nav.install },
  { href: sectionHref("faq"), label: dict.nav.faq },
];
---

<a class="skip" href="#main">{dict.nav.skip}</a>

<header class="menubar">
  <a class="menubar__brand" href={homePath(locale)} aria-label={dict.nav.home}>
    <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
      <path d="M15.6 13.4A6.6 6.6 0 1 1 13.3 4.3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      <circle cx="15.3" cy="5.6" r="2.5" fill="var(--mint)" />
    </svg>
    <span>Orbix</span>
  </a>

  <nav class="menubar__nav" aria-label={dict.nav.label}>
    <ul>
      {sections.map((section) => (
        <li><a href={section.href}>{section.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="menubar__extras">
    <a class="menubar__download" href={release.dmgUrl}>{dict.nav.download}</a>

    <button class="menubar__item menubar__input" type="button" popovertarget="language-menu">
      <span class="visually-hidden">{dict.nav.language}: </span>
      <span class="menubar__input-badge" title={localeInfo[locale].name}>{localeInfo[locale].short}</span>
    </button>

    <button class="menubar__item menubar__status" type="button" popovertarget="orbix-panel" data-status>
      <span class="visually-hidden">{dict.nav.openPanel}: </span>
      <svg viewBox="0 0 20 18" width="20" height="18" aria-hidden="true">
        <circle cx="10" cy="9" r={radius} fill="none" stroke="currentColor" stroke-opacity="0.32" stroke-width="1.6" />
        <circle
          data-status-arc
          cx="10" cy="9" r={radius} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
          pathLength="100" stroke-dasharray={`${start} 100`}
          transform="rotate(-90 10 9)"
        />
        <circle data-status-dot cx="14.4" cy="4.6" r="2.6" fill="var(--mint)" />
      </svg>
      <span class="menubar__pct" data-status-pct>{start}%</span>
    </button>

    <time class="menubar__item menubar__clock" data-clock aria-hidden="true"></time>
  </div>
</header>

<div id="language-menu" class="menu" popover data-anchor-to=".menubar__input">
  <p class="menu__title">{dict.nav.language}</p>
  <ul>
    {locales.map((code) => (
      <li>
        <a
          href={alternates[code] ?? homePath(code)}
          hreflang={localeInfo[code].hreflang}
          lang={localeInfo[code].hreflang}
          aria-current={code === locale ? "true" : undefined}
        >
          <svg class="menu__check" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="m2 6.4 2.6 2.6L10 3.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="menu__short">{localeInfo[code].short}</span>
          {localeInfo[code].name}
        </a>
      </li>
    ))}
  </ul>
</div>

<div id="orbix-panel" class="panel-pop" popover data-anchor-to=".menubar__status">
  <Shot dark={compactDark} light={compactLight} width={340} alt={dict.tour.alt} />
</div>

<style>
  .skip {
    position: fixed;
    top: 0.4rem;
    left: 0.6rem;
    z-index: 30;
    padding: 0.5rem 0.9rem;
    border-radius: 0.5rem;
    background: var(--mint);
    color: var(--sky-deep);
    font-weight: 600;
    translate: 0 -200%;
  }
  .skip:focus { translate: 0 0; }

  .menubar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    height: var(--menubar-h);
    padding-inline: max(0.9rem, env(safe-area-inset-left)) max(0.6rem, env(safe-area-inset-right));
    font-family: var(--system);
    font-size: 0.875rem;
    color: var(--menubar-ink);
    background: var(--menubar);
    backdrop-filter: blur(22px) saturate(1.6);
    -webkit-backdrop-filter: blur(22px) saturate(1.6);
    box-shadow: 0 0.5px 0 rgb(0 0 0 / 0.25);
  }

  .menubar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    text-decoration: none;
  }

  .menubar__nav ul { display: flex; gap: 0.15rem; margin: 0; padding: 0; list-style: none; }
  .menubar__nav a,
  .menubar__item {
    display: inline-flex;
    align-items: center;
    height: 1.6rem;
    padding-inline: 0.55rem;
    border-radius: 0.35rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .menubar__nav a:hover,
  .menubar__item:hover,
  .menubar__item.is-open { background: rgb(127 127 127 / 0.2); }

  .menubar__extras {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-left: auto;
  }

  .menubar__download {
    margin-right: 0.5rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--mint);
    color: var(--sky-deep);
    font-weight: 600;
    font-size: 0.8125rem;
    text-decoration: none;
  }

  button.menubar__item {
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: default;
  }

  .menubar__input-badge {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.05rem;
    padding-inline: 0.2rem;
    border: 1.2px solid currentColor;
    border-radius: 0.25rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .menubar__status { gap: 0.25rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .menubar__pct { min-width: 2.4em; text-align: left; }
  [data-status-arc] { transition: stroke-dasharray 0.2s linear; }
  .menubar__clock { min-width: 5.5rem; justify-content: flex-end; font-variant-numeric: tabular-nums; }

  /* Menus: macOS-style, translucent and rounded, placed under their item by script. */
  [popover] {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--fog);
  }

  .menu {
    min-width: 13rem;
    padding: 0.3rem;
    border-radius: 0.6rem;
    background: var(--menu);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    box-shadow: 0 0 0 0.5px rgb(127 127 127 / 0.4), 0 18px 40px -12px rgb(0 0 0 / 0.5);
    font-family: var(--system);
    font-size: 0.875rem;
  }
  .menu__title { padding: 0.3rem 0.6rem 0.2rem; color: var(--lichen); font-size: 0.75rem; font-weight: 600; }
  .menu ul { margin: 0; padding: 0; list-style: none; }
  .menu a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0.3rem;
    text-decoration: none;
  }
  .menu a:hover, .menu a:focus-visible { background: var(--mint); color: var(--sky-deep); outline: none; }
  .menu__check { visibility: hidden; flex: none; }
  .menu a[aria-current] .menu__check { visibility: visible; }
  .menu__short { width: 1.6rem; font-size: 0.6875rem; font-weight: 700; opacity: 0.6; }

  .panel-pop {
    width: min(340px, calc(100vw - 1rem));
    background: none;
    overflow: auto;
    border-radius: 12px;
  }
  .panel-pop img { width: 100%; border-radius: 12px; box-shadow: var(--shot-shadow); }

  .menu:popover-open, .panel-pop:popover-open {
    animation: drop 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.1);
    transform-origin: top right;
  }
  @keyframes drop {
    from { opacity: 0; transform: translateY(-4px) scale(0.97); }
  }

  @media (prefers-color-scheme: light) {
    .menubar { box-shadow: 0 0.5px 0 rgb(0 0 0 / 0.12); }
    .menubar__download { color: #f4faf7; }
    .menu a:hover, .menu a:focus-visible { color: #f4faf7; }
  }

  @media (max-width: 70rem) {
    .menubar__nav li:nth-child(n + 5) { display: none; }
  }
  @media (max-width: 54rem) {
    .menubar__nav { display: none; }
    /* On small screens the page passes close under the bar, so it is nearly opaque. */
    .menubar { background: var(--menubar-solid); }
  }
  @media (pointer: coarse), (max-width: 54rem) {
    .menubar__nav a, .menubar__item { height: 2.25rem; padding-inline: 0.7rem; }
    .menubar__brand { min-height: 2.25rem; }
    .menubar__download { padding: 0.45rem 0.9rem; }
    .menubar__input-badge { height: 1.25rem; min-width: 1.9rem; font-size: 0.6875rem; }
    .menu a { padding-block: 0.6rem; }
  }
  @media (max-width: 30rem) {
    .menubar__clock { display: none; }
    .menubar { gap: 0.5rem; }
  }
</style>

<script>
  // The clock, in the visitor's language and time zone.
  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
  if (clock) {
    const format = new Intl.DateTimeFormat(document.documentElement.lang, {
      weekday: "short",
      hour: "numeric",
      minute: "2-digit",
    });
    const tick = () => {
      const now = new Date();
      clock.textContent = format.format(now);
      clock.dateTime = now.toISOString();
    };
    tick();
    setInterval(tick, 15_000);
  }

  // Popovers open under the menu bar item that toggles them, right edges aligned.
  document.querySelectorAll<HTMLElement>("[popover][data-anchor-to]").forEach((popover) => {
    const anchor = document.querySelector<HTMLElement>(popover.dataset.anchorTo!);
    if (!anchor) return;
    popover.addEventListener("beforetoggle", (event) => {
      if ((event as ToggleEvent).newState !== "open") return;
      const rect = anchor.getBoundingClientRect();
      const top = rect.bottom + 6;
      popover.style.top = `${top}px`;
      popover.style.maxHeight = `${window.innerHeight - top - 8}px`;
      requestAnimationFrame(() => {
        const width = popover.offsetWidth;
        const right = Math.min(window.innerWidth - 8, rect.right + 8);
        popover.style.left = `${Math.max(8, right - width)}px`;
      });
      popover.style.left = `${Math.max(8, rect.right + 8 - 340)}px`;
    });
    popover.addEventListener("toggle", (event) => {
      anchor.classList.toggle("is-open", (event as ToggleEvent).newState === "open");
    });
  });
</script>
